# ── Supabase ────────────────────────────────────────────────
# Supabase 대시보드 → Project Settings → API 에서 확인할 수 있습니다.

# 프로젝트 URL (예: https://abcdefghijklm.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# 브라우저에 노출되어도 되는 공개 키입니다.
# 대시보드 개편 이후에는 "Publishable key"(sb_publishable_... )로 표시되며,
# 예전 프로젝트에서는 "anon public"(eyJ... )으로 표시됩니다. 둘 중 하나만 넣으면 됩니다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── 서버 전용 키 (선택) ─────────────────────────────────────
# RLS를 우회하는 관리자 키입니다. 브라우저에 절대 노출하면 안 되며,
# 관리자 작업이 필요할 때만 사용합니다. 없어도 앱은 정상 동작합니다.
# 대시보드에서는 "Secret key"(sb_secret_... ) 또는 "service_role"로 표시됩니다.
SUPABASE_SERVICE_ROLE_KEY=
