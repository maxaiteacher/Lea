# ── AI provider ─────────────────────────────────────────────
# "claude" (기본) 또는 "openai"
AI_PROVIDER=claude

# Claude 사용 시
ANTHROPIC_API_KEY=

# OpenAI 사용 시
OPENAI_API_KEY=

# ── 데이터베이스 (PostgreSQL) ───────────────────────────────
# Vercel 배포: Storage 탭에서 Postgres(Neon)를 연결하면 자동으로 채워집니다.
# 로컬 개발: 로컬 또는 클라우드 Postgres 연결 문자열을 넣으세요.
#   예) postgresql://user:password@localhost:5432/lea?schema=public
DATABASE_URL=
